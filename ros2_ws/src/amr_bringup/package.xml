<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration for the AMR fleet system</description>
  <maintainer email="anzal.ahmed2001@gmail.com">Anzal Ahmed</maintainer>
  <license>Apache-2.0</license>

  <depend>amr_robot_core</depend>
  <depend>amr_monitoring</depend>
  <depend>launch_ros</depend>
  <!-- fleet_coordinator and safety are monitoring-node only; exec_depend avoids colcon requiring them on robot builds -->
  <exec_depend>amr_fleet_coordinator</exec_depend>
  <exec_depend>amr_safety</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
